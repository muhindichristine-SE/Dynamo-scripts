          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Calculate viewport positions for grid layout",
      "Code": "// Calculate grid positions for multiple sections\nsectionCount = Count(sections);\nmaxCols = config.maxCols;\nrows = Math.Ceiling(sectionCount / maxCols);\n\npositions = [];\ncol = 0;\nrow = 0;\n\nfor(i in 0..sectionCount-1)\n{\n  x = config.startX + (col * config.spacingX);\n  y = config.startY - (row * config.spacingY);\n  positions = Append(positions, [x, y]);\n  col = col + 1;\n  \n  if(col >= config.maxCols)\n  {\n    col = 0;\n    row = row + 1;\n  }\n};\n\npositions;",
      "X": 800.0,
      "Y": 150.0,
      "IsVisible": true,
      "IsUpstreamVisible": true,
      "UpstreamNodeIds": ["9", "2", "12"],
      "DownstreamNodeIds": ["13"],
      "Excluded": false,
      "HasUI": false,
      "Frozen": false,
      "UsingDefaultValue": false,
      "Name": "Calculate Positions",
      "ElementResolver": null
    },
